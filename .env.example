# ==== Telegram ====
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL publik server kamu setelah deploy ke Render, contoh:
# https://telegram-nota-bot.onrender.com
# JANGAN isi ini saat development lokal (biarkan kosong / pakai polling mode)
WEBHOOK_URL=

# ==== Gemini (Google AI Studio) ====
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==== Supabase ====
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key-here

# ==== Google Sheets (Service Account) ====
# Ambil dari file JSON yang di-download saat membuat service account.
# GOOGLE_SHEETS_CLIENT_EMAIL = field "client_email"
# GOOGLE_SHEETS_PRIVATE_KEY  = field "private_key" (JAGA agar \n tetap ada, lihat catatan di README)
GOOGLE_SHEETS_CLIENT_EMAIL=nota-bot-sheets@your-project.iam.gserviceaccount.com
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxxxxxxxxxxxxxxxxxxxxx\n-----END PRIVATE KEY-----\n"

# ID spreadsheet tujuan, diambil dari URL:
# https://docs.google.com/spreadsheets/d/INI_ID_NYA/edit
SPREADSHEET_ID=your-spreadsheet-id-here

# Nama sheet/tab tujuan (default: Sheet1)
SHEET_NAME=Sheet1

# Port server (Render akan set otomatis, default 3000 untuk lokal)
PORT=3000
